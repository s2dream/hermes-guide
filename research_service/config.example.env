# Copy to .research/runtime.env (ignored by Git). Never put real keys in this file.
# Absolute paths to a PREPARED Hermes checkout and its Python environment.
HERMES_SOURCE=/absolute/path/to/hermes-agent
HERMES_PYTHON=/absolute/path/to/prepared/python
RESEARCH_PROVIDER=openrouter
HERMES_RESEARCH_MODEL=your-provider-model-id
OPENROUTER_API_KEY=replace-on-server
TAVILY_API_KEY=replace-on-server
# For direct OpenAI: RESEARCH_PROVIDER=openai and OPENAI_API_KEY instead.
